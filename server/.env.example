NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/natures-golden-gift
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CASHFREE_ENV=SANDBOX
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_RETURN_URL=http://localhost:5173/checkout
PUBLIC_API_URL=http://localhost:5000

SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_PICKUP_LOCATION=your_registered_pickup_location_name
SHIPROCKET_PICKUP_PINCODE=your_six_digit_pickup_pincode
SHIPROCKET_WEBHOOK_TOKEN=replace_with_a_long_random_webhook_token
